{
  "name": "autorag-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "deploy": "node scripts/build-assets.mjs && wrangler deploy",
    "dev": "node scripts/build-assets.mjs && wrangler dev"
  },
  "dependencies": {
    "@cloudflare/containers": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.0",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
