{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autorag-normativo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [{
    "class_name": "AutoRAGContainer",
    "image": "./Dockerfile",
    "image_build_context": "..",
    "instance_type": "standard-1",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "AutoRAGContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AutoRAGContainer"] }],
  "r2_buckets": [{
    "binding": "STATE",
    "bucket_name": "autorag-normativo-state"
  }],
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 10000 }
}
