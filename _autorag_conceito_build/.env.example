# As chaves são lidas somente pelo serviço Python. Nunca envie ao GitHub.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gere um segredo aleatório com pelo menos 32 caracteres para acesso remoto.
AUTORAG_API_TOKEN=
AUTORAG_ENV=development
# Pasta persistente de dados/índices/histórico/jobs. Padrão: pasta da aplicação.
# AUTORAG_PROJECT_DIR=/data
# Raízes autorizadas para caminhos locais; separador ; no Windows, : no Linux.
# AUTORAG_ALLOWED_SOURCE_ROOTS=D:\documentos;D:\normas
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# No Cloudflare Pages, defina BACKEND_URL=https://seu-servico-python.example

# LLM para elaboração dos tópicos: padrão OpenAI gpt-6-luna.
# API compatível com Chat Completions e saídas JSON estruturadas:
# AUTORAG_LLM_BASE_URL=https://seu-servico.example/v1
# AUTORAG_LLM_API_KEY=
# No Ollama, instale separadamente um modelo generativo.
# BGE-M3 e EmbeddingGemma são somente modelos de embeddings.
# Ollama generativo separado dos embeddings (local ou remoto HTTPS):
# AUTORAG_LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
